  '*--fps[fréquence à évaluer]:fps:(60 90 100 120 144 165 240)' \
  '--save[enregistrer les mesures]:fichier:_files -g "*.json"' \
  '--load[rejouer des mesures enregistrées]:fichier:_files -g "*.json"' \
  '--json[sortie machine]' \
  '(-v --verbose)'{-v,--verbose}'[journal détaillé]' \
  '--no-color[sans couleurs]' \
  '--pause[attendre une touche avant de fermer]'
